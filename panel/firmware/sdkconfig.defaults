# The board: ESP32-S3-WROOM-1-N16R8 (16 MB flash, 8 MB octal PSRAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Frame buffers live in PSRAM: fetch instructions and read-only data from it too, so a
# flash write does not stall the display.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# LVGL: 16-bit color, the C library's allocator (so LVGL can use PSRAM), and the fonts.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# The log goes to UART0 only, so the native USB port carries nothing but the link.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# LVGL draws from the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
