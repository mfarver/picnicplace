  "info": {
    "description": "REST API for PicnicPlace Core. Live state streams over the WebSocket at `/api/v1/events`; its messages are described by the `ServerEvent` and `ClientMessage` schemas.",
    "title": "PicnicPlace Core API",
    "version": "0.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Liveness check. Does not require authentication.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/machine": {
      "get": {
        "operationId": "get_machine_api_v1_machine_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Machine",
        "tags": [
          "machine"
        ]
      }
    },
    "/api/v1/machine/description": {
      "get": {
        "description": "The machine profile: geometry, nozzles, cameras, feeders, and the list of I/O.",
