            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Machine Description",
        "tags": [
          "machine"
        ]
      }
    },
    "/api/v1/machine/estop": {
      "post": {
        "description": "Emergency stop. Allowed for any authenticated client, in any state.",
        "operationId": "estop_api_v1_machine_estop_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Estop",
        "tags": [
          "machine"
        ]
      }
    },
    "/api/v1/machine/home": {
      "post": {
        "description": "Start homing. Returns an operation; follow it over the event socket.",
        "operationId": "home_api_v1_machine_home_post",
