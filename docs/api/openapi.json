            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresenceState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Presence",
        "tags": [
          "system"
        ]
      }
    }
  }
